---
import { CERTIFICATES, CERTIFICATE_TITLE } from "../constants/Certificates";
---

<section
    id="Certificates"
    class="scroll-mt-24 border-t border-t-slate-200 pt-4 grid grid-cols-1 md:grid-cols-3 gap-4"
>
    <div class="mx-4 text-balance space-y-3 col-span-3">
        <h2 class="uppercase text-base text-center md:text-start md:text-lg">04 · CERTIFICADOS</h2>
    </div>

    <div class="col-span-3 grid-cols-2 mx-4 md:mx-10 space-y-3">
        <div
            class="hover:border-yellow-300 hover:scale-105 duration-300 bg-slate-900 border-2 rounded-2xl border-slate-700 px-6 py-4 flex justify-between"
        >
            <h1 class="p-2 text-lg md:text-xl text-slate-200">
                {CERTIFICATE_TITLE.location}
                <br>
                <p class="text-xs md:text-base text-slate-400 italic">{CERTIFICATE_TITLE.name} | {CERTIFICATE_TITLE.yearStart} - {CERTIFICATE_TITLE.yearEnd}</p>
            </h1>
            <h2
                class="p-2 justify-center items-center text-cyan-600 font-bold uppercase text-sm md:text-base italic rounded-2xl"
            >
                {CERTIFICATE_TITLE.status}
            </h2>
        </div>
    </div>
        
    <div class="grid grid-cols-1 md:grid-cols-2 col-span-3 mx-4 md:mx-10 gap-5 text-balance">
        {
            CERTIFICATES.map((cert) => (
                <div class="hover:border-yellow-300 duration-300 hover:scale-105 bg-slate-900 border-2 rounded-2xl border-slate-700 px-6 py-4 flex justify-between items-center">
                    <div class="p-2">
                        <p class="text-xs md:text-base text-slate-200 italic">
                            {cert.name} - {cert.location}
                        </p>
                    </div>
                    <span class="p-2 flex justify-center items-center text-cyan-600 font-bold uppercase text-base italic">
                        {cert.date}
                    </span>
                </div>
            ))
        }
    </div>
</section>
