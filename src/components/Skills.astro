<script>
    const carousel = document.getElementById("skill-carousel")
    const dots = document.querySelectorAll<HTMLElement>("#skills-dots span")

    carousel?.addEventListener("scroll", () => {
        const index = Math.round(carousel.scrollLeft / carousel.clientWidth);

        dots.forEach((dot, i) => {
            dot.classList?.toggle("bg-cyan-400", i === index)
            dot.classList?.toggle("bg-slate-600", i !== index)
        })
    })
</script>